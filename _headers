# Cloudflare Pages 部署文件
# - /api/*  → Cloudflare Pages Functions
# - 其他    → 直接静态托管

[build]
command   = ""
publish   = "."

[[headers]]
  for = "/assets/*"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "/admin/*"
  [headers.values]
    Cache-Control = "no-cache"

